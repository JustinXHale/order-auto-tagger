# Copy to .env for local development. Never commit .env.

# PostgreSQL (required for Prisma). Examples:
# - Default used by `shopify app dev` if unset: postgresql://postgres:postgres@127.0.0.1:5432/order_auto_tagger
#   Start DB: docker run -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=order_auto_tagger -p 5432:5432 -d postgres:16
# - Railway: paste "DATABASE_URL" from your Postgres service variables
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Populated by Shopify CLI during `shopify app dev` — not usually committed:
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SCOPES=read_orders,write_orders,read_products
# SHOPIFY_APP_URL=
